# 统一行尾：仓库内一律存 LF，检出时按平台自动转换，避免跨平台 diff 噪音
* text=auto

# 明确指定脚本行尾：shell 必须 LF，PowerShell 用 CRLF
*.sh   text eol=lf
*.ps1  text eol=crlf

# 源码与文档按文本处理
*.hpp  text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.c    text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
